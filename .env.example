# Supabase
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Service role (apenas scripts locais/seed; nunca no front)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Lalamove (via Supabase Secrets)
# LALAMOVE_API_KEY=xxx
# LALAMOVE_API_SECRET=xxx

# Mapbox (via Supabase Secrets)
# MAPBOX_ACCESS_TOKEN=xxx

# Bitrix24 (via Supabase Secrets)
# BITRIX24_CLIENT_ID=xxx
# BITRIX24_CLIENT_SECRET=xxx

# Lovable AI (via Supabase Secrets)
# LOVABLE_API_KEY=xxx
