# Supabase
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Service role (apenas scripts locais/seed; nunca no front)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Lalamove (via Supabase Secrets)
# LALAMOVE_API_KEY=xxx
# LALAMOVE_API_SECRET=xxx

# Mapbox (via Supabase Secrets — nunca no front)
# MAPBOX_ACCESS_TOKEN=xxx          # pk. — front-end via get-mapbox-token (já existe)
# MAPBOX_SERVER_TOKEN=xxx          # sk. — geo-gateway server-side (etapa 3 do plano Mapbox)
# MAPBOX_TOKENS_API_TOKEN=xxx      # sk. com tokens:write — rotação automática (etapa 9)
# MAPBOX_USERNAME=promobrindes     # username da conta Mapbox

# Google Maps Platform — servidor (via Supabase Secrets, nunca no front)
# GOOGLE_MAPS_API_KEY=xxx
# Google Maps Platform — navegador (Vite, exposto no bundle: restringir por
# HTTP referrer no Google Cloud). Com estas duas o Mapa usa Map ID e
# Advanced Markers; sem elas cai no conector gerenciado (etapa 75).
# VITE_GOOGLE_MAPS_BROWSER_KEY=xxx
# VITE_GOOGLE_MAPS_MAP_ID=xxx

# Bitrix24 (via Supabase Secrets)
# BITRIX24_CLIENT_ID=xxx
# BITRIX24_CLIENT_SECRET=xxx

# Lovable AI (via Supabase Secrets)
# LOVABLE_API_KEY=xxx
