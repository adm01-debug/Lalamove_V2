# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env (secrets must never be committed; use .env.example as the template)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Grafo de código (graphify): ~dezenas de MB, cada clone gera o seu
graphify-out/

# gerado pelo contexto.yml na branch contexto (nunca em main); manual/ é texto humano e fica em main
docs/contexto/*
!docs/contexto/regras/
docs/contexto/regras/*
!docs/contexto/regras/manual/

# TypeScript build info (artefato de build, gerado localmente)
*.tsbuildinfo

# Python bytecode (gerado pelo interpretador)
__pycache__/
*.pyc
*.pyo

# Lockfile do Deno: a CI roda deno v1.x e nao le lockfile v5 gerado pelo deno 2.x
deno.lock

# Artefatos locais do CLI do Supabase (link do projeto, versoes de servico)
supabase/.temp/
